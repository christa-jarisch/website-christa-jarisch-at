---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import portrait from '../assets/christa-portrait.jpg';
import laughing from '../assets/christa-lachend.jpg';
import {
  contact, hero, about, values, organisation, beliefs,
  stations, education, press, quote,
} from '../data/site';

const marqueeWords = ['Klarheit', 'Vertrauen', 'Veränderung', 'Durchatmen', 'Ankommen', 'Struktur', 'Herz', 'Freiheit'];

const nav = [
  { href: '#ueber-mich', label: 'Über mich' },
  { href: '#staerken', label: 'Stärken' },
  { href: '#erfahrung', label: 'Erfahrung' },
  { href: '#werdegang', label: 'Werdegang' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: contact.name,
  email: `mailto:${contact.email}`,
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Wien', addressCountry: 'AT' },
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <!-- Hide the hero until the motion script takes over; falls back to visible after 3s. -->
  <script is:inline slot="head">
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('motion');
      setTimeout(() => document.documentElement.classList.remove('motion'), 3000);
    }
  </script>

  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#top" class="brand">Christa <em>Jarisch</em></a>
      <nav aria-label="Hauptnavigation">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#kontakt" class="btn btn-primary btn-sm">Kontakt</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-text">
        <p class="eyebrow" data-hero-fade>{hero.eyebrow}</p>
        <h1>
          <span class="line"><span class="line-inner">Christa</span></span>
          <span class="line"><span class="line-inner"><em>Jarisch</em></span></span>
        </h1>
        <p class="hero-claim" data-hero-fade>{hero.title}</p>
        <p class="hero-lead" data-hero-fade>{hero.lead}</p>
        <div class="hero-cta" data-hero-fade>
          <a href="#ueber-mich" class="btn btn-primary">Mehr über mich</a>
          <a href="#kontakt" class="btn btn-ghost">Kontakt aufnehmen</a>
        </div>
      </div>
      <figure class="hero-photo">
        <div class="arch" data-parallax-frame>
          <Image
            src={portrait}
            alt="Porträt von Christa Jarisch, lächelnd, mit roten Ohrringen"
            widths={[360, 540, 684]}
            sizes="(min-width: 56rem) 34vw, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption data-hero-fade>Aus Wien, mit Herz</figcaption>
      </figure>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <span class="marquee-group">
            {marqueeWords.map((w) => <span>{w}<i>✦</i></span>)}
          </span>
        ))}
      </div>
    </div>

    <!-- ÜBER MICH -->
    <section id="ueber-mich" class="section about">
      <div class="wrap about-grid">
        <div class="reveal">
          <p class="eyebrow">Über mich</p>
          <h2 class="section-title">{about.heading}</h2>
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <aside class="about-side">
          <div class="about-photo" data-parallax-frame>
            <Image src={laughing} alt="Christa Jarisch lachend in einem Wiener Gastgarten" widths={[300]} />
          </div>
          <blockquote class="pull" data-scrub-words>„{about.quote}“</blockquote>
        </aside>
      </div>

      <ul class="wrap values" role="list">
        {values.map((v, i) => (
          <li class="value reveal">
            <span class="value-num">0{i + 1}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- STÄRKEN -->
    <section id="staerken" class="section org">
      <div class="wrap">
        <div class="org-head reveal">
          <p class="eyebrow">Was ich gut kann</p>
          <h2 class="section-title">{organisation.heading}</h2>
          <p class="org-lead">{organisation.lead}</p>
        </div>
        <ul class="org-grid" role="list">
          {organisation.items.map((item) => (
            <li class="org-card">
              <span class="rule" aria-hidden="true"></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- HALTUNG -->
    <section class="section beliefs" aria-labelledby="haltung">
      <div class="wrap">
        <h2 class="eyebrow" id="haltung">Was mich leitet</h2>
        <ul role="list">
          {beliefs.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>

    <!-- ERFAHRUNG -->
    <section id="erfahrung" class="section">
      <div class="wrap">
        <p class="eyebrow">Stationen</p>
        <h2 class="section-title reveal">Erfahrung aus vielen Welten.</h2>
        <div class="stations">
          {stations.map((s, i) => (
            <article class="station" style={`--i: ${i}`}>
              <p class="station-kicker"><span class="station-num">0{i + 1}</span>{s.kicker}</p>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.details && (
                <ul class="station-details">
                  {s.details.map((d) => <li>{d}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- WERDEGANG -->
    <section id="werdegang" class="section path">
      <div class="wrap path-grid">
        <div class="path-head reveal">
          <p class="eyebrow">Aus- und Weiterbildungen</p>
          <h2 class="section-title">Ein Leben lang dazulernen.</h2>
        </div>
        <div class="timeline-wrap">
          <span class="timeline-progress" aria-hidden="true"></span>
          <ol class="timeline" role="list">
            {education.map((e) => (
              <li>
                <strong>{e.title}</strong>
                <span>{e.by}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="wrap press">
        <p class="eyebrow">In den Medien</p>
        <ul role="list" class="press-list">
          {press.map((p) => (
            <li class="press-item reveal">
              <span class="press-source">{p.source}</span>
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener">{p.title} ↗</a>
              ) : (
                <span class="press-title">{p.title}</span>
              )}
              <span class="press-date">{p.date}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ZITAT -->
    <section class="quote-band">
      <div class="glow" aria-hidden="true"></div>
      <figure class="wrap">
        <blockquote data-scrub-words>{quote.text}</blockquote>
        <figcaption>— {quote.author}</figcaption>
      </figure>
    </section>

    <!-- KONTAKT -->
    <section id="kontakt" class="section contact">
      <div class="wrap contact-grid">
        <div class="reveal">
          <p class="eyebrow">Kontakt</p>
          <h2 class="section-title">Schreiben Sie mir.</h2>
          <p class="contact-lead">
            Ob Austausch, Anfrage oder einfach ein Hallo – ich freue mich, von Ihnen zu hören.
          </p>
          <div class="contact-actions">
            <a class="btn btn-primary" data-magnetic href={`mailto:${contact.email}`}>{contact.email}</a>
            <a class="btn btn-ghost" href={contact.phoneHref}>{contact.phone}</a>
          </div>
        </div>
        <div class="contact-card reveal">
          <h3>{contact.name}</h3>
          <p>{contact.city}, Österreich</p>
          <dl>
            <dt>E-Mail</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
            <dt>Telefon</dt><dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Motion />
</Base>

<style>
  /* ---------- top bar ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in oklab, var(--paper) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 60%, transparent);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.35rem;
    text-decoration: none;
    letter-spacing: -.01em;
  }
  .brand em { color: var(--accent); }
  .topbar nav { display: none; gap: 2rem; font-size: .92rem; }
  .topbar nav a { text-decoration: none; color: var(--ink-soft); }
  .topbar nav a:hover { color: var(--ink); }
  .btn-sm { padding: .55em 1.1em; font-size: .85rem; }
  @media (min-width: 52rem) { .topbar nav { display: flex; } }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: 1.15fr .85fr; }
  }
  .hero h1 {
    font-size: clamp(3.6rem, 2rem + 8vw, 8.5rem);
    line-height: .92;
    letter-spacing: -.045em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero h1 .line { display: block; overflow: hidden; padding-bottom: .1em; margin-bottom: -.1em; }
  .hero h1 .line-inner { display: inline-block; will-change: transform; }
  .hero h1 em {
    color: var(--accent);
    font-style: italic;
    padding-left: .6em;
    padding-right: .1em;
  }
  .hero-claim {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.25;
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .hero-lead { max-width: 34rem; color: var(--ink-soft); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }

  .hero-photo {
    margin: 0;
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
  }
  /* Phones/tablets: portrait first, a bit smaller, so Christa is visible right away */
  @media (max-width: 55.99rem) {
    .hero { padding-top: 2rem; }
    /* height cap keeps the portrait from filling a landscape phone screen */
    .hero-photo { order: -1; width: min(72%, 20rem, 46svh); }
    .hero .hero-photo figcaption { left: auto; right: -14%; bottom: 1rem; white-space: nowrap; }
  }
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 8% -8% -6% 10%;
    background: var(--paper-2);
    border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%;
    z-index: -1;
  }
  .arch {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: 0 30px 60px -30px rgb(20 20 40 / .45);
  }
  .arch :global(img) {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
    object-position: 50% 20%;
    will-change: transform;
  }
  .hero-photo figcaption {
    position: absolute;
    bottom: 1.25rem;
    left: -1rem;
    background: var(--card);
    padding: .5rem 1rem;
    border-radius: 999px;
    font-size: .8rem;
    font-weight: 500;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / .3);
  }
  .hero-photo figcaption::before {
    content: '';
    display: inline-block;
    width: .55rem;
    height: .55rem;
    margin-right: .5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* hidden start states, only until the motion script takes over */
  :global(.motion) .hero h1 .line-inner { transform: translateY(110%); }
  :global(.motion) [data-hero-fade] { opacity: 0; }
  :global(.motion) .arch { clip-path: inset(100% 0 0 0 round 999px 999px var(--radius) var(--radius)); }

  /* ---------- marquee ---------- */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1.1rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
    white-space: nowrap;
  }
  .marquee-track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-group span { padding-inline: .9em; }
  .marquee i { font-style: normal; color: var(--accent); font-size: .55em; vertical-align: middle; margin-left: 1.8em; }
  @keyframes marquee { to { translate: -50% 0; } }

  /* ---------- about ---------- */
  .about { background: var(--paper-2); }
  .about-grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) {
    .about-grid { grid-template-columns: 1.4fr 1fr; align-items: start; }
  }
  .about-grid p { max-width: 38rem; }
  .about-side { display: grid; gap: 2rem; }
  .about-photo {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    rotate: 2deg;
  }
  .about-photo :global(img) {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
  }
  .pull {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.3;
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
  }

  .values {
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .value {
    background: var(--card);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .value-num { font-size: .8rem; font-weight: 600; color: var(--accent); }
  .value h3 { font-size: 1.9rem; margin: .5rem 0 .75rem; }
  .value p { margin: 0; color: var(--ink-soft); }

  /* ---------- organisation ---------- */
  .org-head { max-width: 46rem; }
  .org-lead { font-size: 1.15em; color: var(--ink-soft); }
  .org-grid {
    list-style: none;
    padding: 0;
    margin-top: 3rem;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    border-top: 1px solid var(--line);
  }
  .org-card {
    padding: 2rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .rule {
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    margin-bottom: 1.5rem;
    transform-origin: left;
    transition: width .5s var(--ease);
  }
  .org-card:hover .rule { width: 5rem; }
  .org-card h3 { font-size: 1.5rem; margin-bottom: .75rem; }
  .org-card p { margin: 0; color: var(--ink-soft); }

  /* ---------- beliefs (dark band) ---------- */
  .beliefs {
    --band-ink: #f7f1e8;
    background: light-dark(#1f2a44, #0e1016);
    color: var(--band-ink);
  }
  .beliefs .eyebrow { color: #ff8f80; }
  .beliefs ul { list-style: none; padding: 0; margin: 0; }
  .beliefs li {
    font-family: var(--serif);
    font-size: clamp(2rem, 1rem + 4vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -.03em;
    padding-block: 1.2rem;
    border-bottom: 1px solid color-mix(in oklab, var(--band-ink) 16%, transparent);
    text-wrap: balance;
  }
  .beliefs li:nth-child(even) { font-style: italic; padding-left: clamp(0rem, 10vw, 10rem); }

  /* ---------- stations (sticky stack) ---------- */
  .stations { display: grid; gap: 1.5rem; }
  .station {
    position: sticky;
    top: calc(5.5rem + var(--i) * 1.5rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.4);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    min-height: min(22rem, 70svh);
    box-shadow: 0 -12px 40px -24px rgb(0 0 0 / .25);
    transform-origin: 50% 0;
  }
  .station-kicker {
    display: flex;
    align-items: center;
    gap: .8rem;
    font-size: .8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--sky);
    margin-bottom: 1rem;
  }
  .station-num {
    font-family: var(--serif);
    font-size: 1.1rem;
    letter-spacing: 0;
    color: var(--accent);
  }
  .station h3 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem); margin-bottom: 1.25rem; }
  .station p { max-width: 40rem; color: var(--ink-soft); font-size: 1.08em; }
  .station-details {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .station-details li {
    font-size: .85rem;
    padding: .35rem .9rem;
    border-radius: 999px;
    background: var(--paper-2);
  }

  /* ---------- path ---------- */
  .path { background: var(--paper-2); }
  .path-grid { display: grid; gap: 2rem; }
  @media (min-width: 56rem) {
    .path-grid { grid-template-columns: 1fr 1.3fr; align-items: start; }
    .path-head { position: sticky; top: 7rem; }
  }
  .timeline-wrap { position: relative; }
  .timeline-wrap::before,
  .timeline-progress {
    content: '';
    position: absolute;
    left: calc(.375rem - 1px);
    top: .5rem;
    bottom: 2.25rem;
    width: 2px;
    background: var(--line);
  }
  .timeline-progress {
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(1);
  }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li {
    position: relative;
    padding: 0 0 1.75rem 2rem;
    display: grid;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .45rem;
    width: .75rem;
    height: .75rem;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--accent);
    transition: background-color .4s, scale .4s var(--ease);
  }
  :global(.has-motion) .timeline li:not(.is-on)::before { background: var(--paper-2); scale: .8; }
  .timeline strong { font-weight: 600; }
  .timeline span { color: var(--ink-soft); font-size: .92rem; }

  .press { margin-top: clamp(3rem, 7vw, 5rem); }
  .press-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .press-item {
    display: grid;
    gap: .25rem;
    background: var(--card);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .press-source { font-size: .8rem; color: var(--ink-soft); }
  .press-item a, .press-title { font-family: var(--serif); font-size: 1.35rem; text-decoration: none; }
  .press-date { font-size: .85rem; color: var(--ink-soft); }

  /* ---------- quote ---------- */
  .quote-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 14vw, 11rem);
    text-align: center;
    isolation: isolate;
  }
  .glow {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(35% 45% at 30% 40%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(40% 50% at 70% 60%, color-mix(in oklab, var(--sky) 20%, transparent), transparent 70%);
    filter: blur(40px);
    animation: drift 24s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to { transform: translate(6%, -4%) rotate(8deg) scale(1.08); }
  }
  .quote-band figure { margin-inline: auto; max-width: 56rem; }
  .quote-band blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2rem, 1rem + 3.8vw, 4.2rem);
    line-height: 1.12;
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .quote-band blockquote::before {
    content: '“';
    display: block;
    font-size: 2.5em;
    line-height: .6;
    color: var(--accent);
  }
  .quote-band figcaption { margin-top: 1.5rem; color: var(--ink-soft); }

  /* ---------- contact ---------- */
  .contact { border-top: 1px solid var(--line); }
  .contact-grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .contact-grid { grid-template-columns: 1.3fr 1fr; align-items: center; } }
  .contact .section-title { font-size: clamp(2.8rem, 1.6rem + 5vw, 6rem); }
  .contact-lead { font-size: 1.15em; max-width: 34rem; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .contact-actions .btn { overflow-wrap: anywhere; }
  .contact-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .contact-card h3 { font-size: 1.6rem; margin-bottom: .25rem; }
  .contact-card > p { color: var(--ink-soft); }
  .contact-card dl { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1.25rem; margin: 1.5rem 0 0; }
  .contact-card dt { color: var(--ink-soft); font-size: .9rem; }
  .contact-card dd { margin: 0; overflow-wrap: anywhere; }
  .contact-card dd a { display: inline-block; padding-block: .35rem; }
  .contact-card dl { align-items: center; }

  @media (prefers-reduced-motion: reduce) {
    .station { position: static; }
  }
</style>
