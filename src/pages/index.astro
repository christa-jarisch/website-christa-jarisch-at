---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/christa-portrait.jpg';
import laughing from '../assets/christa-lachend.jpg';
import {
  contact, hero, about, values, organisation, offers,
  questions, education, press, quote, directions,
} from '../data/site';

const nav = [
  { href: '#ueber-mich', label: 'Über mich' },
  { href: '#staerken', label: 'Stärken' },
  { href: '#angebot', label: 'Angebot' },
  { href: '#werdegang', label: 'Werdegang' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: contact.name,
  jobTitle: 'Dipl. Lebens- und Sozialberaterin, Supervisorin',
  telephone: contact.phone,
  email: `mailto:${contact.email}`,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: '1160',
    addressLocality: 'Wien',
    addressCountry: 'AT',
  },
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="#top" class="brand">Christa <em>Jarisch</em></a>
      <nav aria-label="Hauptnavigation">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#kontakt" class="btn btn-primary btn-sm">Kontakt</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-text">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>
          Christa<br /><em>Jarisch</em>
        </h1>
        <p class="hero-claim">{hero.title}</p>
        <p class="hero-lead">{hero.lead}</p>
        <div class="hero-cta">
          <a href="#kontakt" class="btn btn-primary">Kennenlernen – 20 Min. gratis</a>
          <a href="#ueber-mich" class="btn btn-ghost">Mehr über mich</a>
        </div>
      </div>
      <figure class="hero-photo">
        <Image
          src={portrait}
          alt="Porträt von Christa Jarisch, lächelnd, mit roten Ohrringen"
          widths={[360, 540, 684]}
          sizes="(min-width: 56rem) 34vw, 80vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Wien, 16. Bezirk</figcaption>
      </figure>
    </section>

    <!-- ÜBER MICH -->
    <section id="ueber-mich" class="section about">
      <div class="wrap about-grid">
        <div class="reveal">
          <p class="eyebrow">Über mich</p>
          <h2 class="section-title">{about.heading}</h2>
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <aside class="about-side reveal">
          <Image src={laughing} alt="Christa Jarisch lachend in einem Wiener Gastgarten" widths={[300]} class="about-photo" />
          <blockquote class="pull">„{about.quote}“</blockquote>
        </aside>
      </div>

      <ul class="wrap values" role="list">
        {values.map((v, i) => (
          <li class="value reveal">
            <span class="value-num">0{i + 1}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- ORGANISATION -->
    <section id="staerken" class="section org">
      <div class="wrap">
        <div class="org-head reveal">
          <p class="eyebrow">Was ich gut kann</p>
          <h2 class="section-title">{organisation.heading}</h2>
          <p class="org-lead">{organisation.lead}</p>
        </div>
        <ul class="org-grid" role="list">
          {organisation.items.map((item) => (
            <li class="org-card reveal">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- KENNEN SIE DAS -->
    <section class="section questions" aria-labelledby="fragen">
      <div class="wrap">
        <p class="eyebrow">Kennen Sie das?</p>
        <h2 id="fragen" class="visually-hidden">Kennen Sie das?</h2>
        <ul role="list">
          {questions.map((q) => <li class="reveal">{q}</li>)}
        </ul>
      </div>
    </section>

    <!-- ANGEBOT -->
    <section id="angebot" class="section">
      <div class="wrap">
        <p class="eyebrow">Wobei ich begleite</p>
        <h2 class="section-title reveal">Beratung, Supervision &amp; Seminare.</h2>
        <div class="offers">
          {offers.map((o) => (
            <article class:list={['offer', 'reveal', { 'offer-wide': o.details }]}>
              <p class="offer-kicker">{o.kicker}</p>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
              {o.details && (
                <ul class="offer-details">
                  {o.details.map((d) => <li>{d}</li>)}
                </ul>
              )}
              {o.note && <p class="offer-note">{o.note}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- WERDEGANG -->
    <section id="werdegang" class="section path">
      <div class="wrap path-grid">
        <div class="reveal">
          <p class="eyebrow">Aus- und Weiterbildungen</p>
          <h2 class="section-title">Ein Leben lang dazulernen.</h2>
        </div>
        <ol class="timeline" role="list">
          {education.map((e) => (
            <li class="reveal">
              <strong>{e.title}</strong>
              <span>{e.by}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="wrap press">
        <p class="eyebrow">In den Medien</p>
        <ul role="list" class="press-list">
          {press.map((p) => (
            <li class="press-item reveal">
              <span class="press-source">{p.source}</span>
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener">{p.title} ↗</a>
              ) : (
                <span class="press-title">{p.title}</span>
              )}
              <span class="press-date">{p.date}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ZITAT -->
    <section class="quote-band">
      <figure class="wrap reveal">
        <blockquote>{quote.text}</blockquote>
        <figcaption>— {quote.author}</figcaption>
      </figure>
    </section>

    <!-- KONTAKT -->
    <section id="kontakt" class="section contact">
      <div class="wrap contact-grid">
        <div class="reveal">
          <p class="eyebrow">Kontakt</p>
          <h2 class="section-title">Ich freue mich auf Sie.</h2>
          <p class="contact-lead">
            Beim Erstgespräch schenke ich Ihnen die ersten <strong>20 Minuten</strong> zum Kennenlernen.
            Termine nach telefonischer Vereinbarung.
          </p>
          <div class="contact-actions">
            <a class="btn btn-primary" href={contact.phoneHref}>Anrufen: {contact.phone}</a>
            <a class="btn btn-ghost" href={`mailto:${contact.email}`}>{contact.email}</a>
          </div>
        </div>
        <div class="contact-card reveal">
          <h3>Praxis</h3>
          <address>
            {contact.name}<br />
            {contact.street}<br />
            {contact.city}
          </address>
          <h3>Anreise</h3>
          <ul role="list">
            {directions.map((d) => <li>{d}</li>)}
          </ul>
          <a
            class="map-link"
            href="https://www.openstreetmap.org/search?query=Wurlitzergasse%2050%2C%201160%20Wien"
            target="_blank"
            rel="noopener"
          >Auf der Karte ansehen ↗</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ---------- top bar ---------- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in oklab, var(--paper) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 60%, transparent);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.35rem;
    text-decoration: none;
    letter-spacing: -.01em;
  }
  .brand em { color: var(--accent); }
  .topbar nav { display: none; gap: 2rem; font-size: .92rem; }
  .topbar nav a { text-decoration: none; color: var(--ink-soft); }
  .topbar nav a:hover { color: var(--ink); }
  .btn-sm { padding: .55em 1.1em; font-size: .85rem; }
  @media (min-width: 52rem) { .topbar nav { display: flex; } }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: 1.15fr .85fr; }
  }
  .hero h1 {
    font-size: clamp(3.6rem, 2rem + 8vw, 8.5rem);
    line-height: .92;
    letter-spacing: -.045em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero h1 em {
    color: var(--accent);
    font-style: italic;
    padding-left: .6em;
  }
  .hero-claim {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    margin-top: 2rem;
    margin-bottom: .75rem;
  }
  .hero-lead { max-width: 34rem; color: var(--ink-soft); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }

  .hero-photo {
    margin: 0;
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
  }
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 8% -8% -6% 10%;
    background: var(--paper-2);
    border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%;
    z-index: -1;
  }
  .hero-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: 0 30px 60px -30px rgb(20 20 40 / .45);
  }
  .hero-photo figcaption {
    position: absolute;
    bottom: 1.25rem;
    left: -1rem;
    background: var(--card);
    padding: .5rem 1rem;
    border-radius: 999px;
    font-size: .8rem;
    font-weight: 500;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / .3);
  }
  .hero-photo figcaption::before {
    content: '';
    display: inline-block;
    width: .55rem;
    height: .55rem;
    margin-right: .5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-text > *, .hero-photo {
      animation: rise .9s var(--ease) both;
    }
    .hero-text > :nth-child(2) { animation-delay: .08s; }
    .hero-text > :nth-child(3) { animation-delay: .16s; }
    .hero-text > :nth-child(4) { animation-delay: .24s; }
    .hero-text > :nth-child(5) { animation-delay: .32s; }
    .hero-photo { animation-delay: .2s; }
    @keyframes rise { from { opacity: 0; translate: 0 1.5rem; } }
  }

  /* ---------- about ---------- */
  .about { background: var(--paper-2); }
  .about-grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) {
    .about-grid { grid-template-columns: 1.4fr 1fr; align-items: start; }
  }
  .about-grid p { max-width: 38rem; }
  .about-side { display: grid; gap: 1.5rem; }
  .about-photo {
    width: 100%;
    max-width: 22rem;
    border-radius: var(--radius);
    rotate: 2deg;
  }
  .pull {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.3;
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
  }

  .values {
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .value {
    background: var(--card);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .value-num { font-size: .8rem; font-weight: 600; color: var(--accent); }
  .value h3 { font-size: 1.9rem; margin: .5rem 0 .75rem; }
  .value p { margin: 0; color: var(--ink-soft); }

  /* ---------- organisation ---------- */
  .org-head { max-width: 46rem; }
  .org-lead { font-size: 1.15em; color: var(--ink-soft); }
  .org-grid {
    list-style: none;
    padding: 0;
    margin-top: 3rem;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    border-top: 1px solid var(--line);
  }
  .org-card {
    padding: 2rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .org-card::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    margin-bottom: 1.5rem;
    transition: width .5s var(--ease);
  }
  .org-card:hover::before { width: 5rem; }
  .org-card h3 { font-size: 1.5rem; margin-bottom: .75rem; }
  .org-card p { margin: 0; color: var(--ink-soft); }

  /* ---------- questions ---------- */
  .questions {
    --band-ink: #f7f1e8;
    background: light-dark(#1f2a44, #0e1016);
    color: var(--band-ink);
  }
  .questions .eyebrow { color: #ff8f80; }
  .questions ul { list-style: none; padding: 0; margin: 0; }
  .questions li {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -.02em;
    padding-block: .9rem;
    border-bottom: 1px solid color-mix(in oklab, var(--band-ink) 18%, transparent);
    text-wrap: balance;
  }
  .questions li:nth-child(even) { font-style: italic; padding-left: clamp(0rem, 8vw, 8rem); }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  /* ---------- offers ---------- */
  .offers {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .offer {
    container-type: inline-size;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  }
  .offer:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -28px rgb(0 0 0 / .35); }
  @media (min-width: 56rem) {
    .offers { grid-template-columns: repeat(2, 1fr); }
    .offer-wide { grid-column: 1 / -1; }
  }
  .offer-kicker { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--sky); margin-bottom: .5rem; }
  .offer h3 { font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem); margin-bottom: 1rem; }
  .offer-details {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .offer-details li {
    font-size: .85rem;
    padding: .35rem .9rem;
    border-radius: 999px;
    background: var(--paper-2);
  }
  .offer-note { font-size: .9rem; color: var(--ink-soft); margin: 0; }

  /* ---------- path ---------- */
  .path { background: var(--paper-2); }
  .path-grid { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .path-grid { grid-template-columns: 1fr 1.3fr; } }
  .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: .35rem;
    top: .5rem;
    bottom: .5rem;
    width: 1px;
    background: var(--line);
  }
  .timeline li {
    position: relative;
    padding: 0 0 1.75rem 2rem;
    display: grid;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .45rem;
    width: .75rem;
    height: .75rem;
    border-radius: 50%;
    background: var(--paper-2);
    border: 2px solid var(--accent);
  }
  .timeline strong { font-weight: 600; }
  .timeline span { color: var(--ink-soft); font-size: .92rem; }

  .press { margin-top: clamp(3rem, 7vw, 5rem); }
  .press-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .press-item {
    display: grid;
    gap: .25rem;
    background: var(--card);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .press-source { font-size: .8rem; color: var(--ink-soft); }
  .press-item a, .press-title { font-family: var(--serif); font-size: 1.35rem; text-decoration: none; }
  .press-date { font-size: .85rem; color: var(--ink-soft); }

  /* ---------- quote ---------- */
  .quote-band { padding-block: clamp(4rem, 10vw, 8rem); text-align: center; }
  .quote-band figure { margin-inline: auto; max-width: 52rem; }
  .quote-band blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.8rem, 1rem + 3.2vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: -.02em;
    text-wrap: balance;
  }
  .quote-band blockquote::before {
    content: '“';
    display: block;
    font-size: 2.5em;
    line-height: .6;
    color: var(--accent);
  }
  .quote-band figcaption { margin-top: 1.5rem; color: var(--ink-soft); }

  /* ---------- contact ---------- */
  .contact { border-top: 1px solid var(--line); }
  .contact-grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .contact-grid { grid-template-columns: 1.3fr 1fr; align-items: start; } }
  .contact-lead { font-size: 1.15em; max-width: 34rem; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .contact-actions .btn { overflow-wrap: anywhere; }
  .contact-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .contact-card h3 { font-size: 1.3rem; margin-bottom: .5rem; }
  .contact-card h3:not(:first-child) { margin-top: 1.75rem; }
  .contact-card address { font-style: normal; }
  .contact-card ul { padding-left: 1.1rem; margin: 0; color: var(--ink-soft); font-size: .95rem; }
  .contact-card li + li { margin-top: .4rem; }
  .map-link { display: inline-block; margin-top: 1.5rem; font-weight: 600; font-size: .9rem; }
</style>
