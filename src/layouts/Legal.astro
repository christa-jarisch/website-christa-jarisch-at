---
import Base from './Base.astro';

interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${title} – Christa Jarisch`} noindex>
  <header class="wrap bar">
    <a href={base} class="back">← Christa <em>Jarisch</em></a>
  </header>
  <main class="wrap legal">
    <h1>{title}</h1>
    <slot />
  </main>
</Base>

<style>
  .bar { padding-block: 1.5rem; }
  .back { font-family: var(--serif); font-size: 1.25rem; text-decoration: none; }
  .back em { color: var(--accent); }
  .legal { max-width: 44rem; padding-block: 3rem 6rem; }
  h1 { font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem); margin-bottom: 2rem; }
  .legal :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 .75rem; }
  .legal :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 1.5rem; }
  .legal :global(dt) { color: var(--ink-soft); }
  .legal :global(dd) { margin: 0; }
</style>
